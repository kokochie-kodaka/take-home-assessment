APP_NAME="Invitation Draft App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# setup.sh が Codespaces の転送 URL で自動設定します
APP_URL=https://codespace-8000.app.github.dev

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE は database/database.sqlite をデフォルト利用

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
